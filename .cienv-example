# =============================================================================
# .cienv-example
# =============================================================================
# Every environment variable this repo's CI/CD pipeline depends on.
#
# Deployment today runs via direct `helm upgrade --install` from GitLab CI
# (see .gitlab/ci/gitops.yml). The ArgoCD variables in section 8 are for the
# PLANNED future GitOps migration and are NOT consumed by the current pipeline.
#
# Sections 1-3 are non-sensitive defaults already committed at the top of
# .gitlab-ci.yml — edit them there directly, or override the same names as
# GitLab CI/CD Variables (Settings → CI/CD → Variables) if you don't want to
# edit the repo. Section 4 (cluster tokens) MUST be set as GitLab CI/CD
# Variables — never commit them anywhere.
#
# A local .cienv copy is gitignored — never commit real values.
# =============================================================================


# ─── 1. PROJECT IDENTITY ─────────────────────────────────────────────────────
# Helm release name + the chart directory name (helm/charts/<PROJECT_NAME>).
# Used throughout gitops.yml. Default already set in .gitlab-ci.yml.

PROJECT_NAME=zabbix-portal


# ─── 2. RUNNER + PRIVATE-REGISTRY IMAGES ─────────────────────────────────────
# Declared as placeholders at the top of .gitlab-ci.yml (lines ~17-24).
# validate:variables (detect.yml) hard-fails the pipeline if any is unset.

RUNNER_TAG=<your-runner-tag>                # GitLab runner tag, e.g. docker
KANIKO_IMAGE=<your-registry>/kaniko:latest
PYTHON_IMAGE=<your-registry>/python:3.12-slim
NODE_IMAGE=<your-registry>/node:22-alpine
HELM_IMAGE=<your-registry>/helm:latest
GIT_IMAGE=<your-registry>/alpine:3.20       # used by the `detect` + `validate:variables` jobs


# ─── 3. CONTAINER REGISTRY ───────────────────────────────────────────────────
# ARTIFACTORY_REGISTRY is a placeholder at the top of .gitlab-ci.yml (line 27).
# python.yml / node.yml / gitops.yml all consume it. Images are pushed/pulled as:
#     $ARTIFACTORY_REGISTRY/backend:<tag>
#     $ARTIFACTORY_REGISTRY/frontend:<tag>

ARTIFACTORY_REGISTRY=<your-artifactory-registry>


# ─── 4. KUBERNETES NAMESPACE + CLUSTER DEPLOY ACCESS ─────────────────────────
# K8S_NAMESPACE, *_SERVER are placeholders in .gitlab-ci.yml (lines ~33-39).
# *_TOKEN MUST be set as real GitLab CI/CD Variables — Masked + Protected.
# DR has its OWN cluster — it does not fall back to the production server/token.
# validate:variables hard-fails if any of these (including the tokens) is unset.

K8S_NAMESPACE=zabbix-portal

STAGING_SERVER=https://api.staging-cluster.example.com:6443
STAGING_TOKEN=<paste-staging-serviceaccount-token>

PROD_SERVER=https://api.prod-cluster.example.com:6443
PROD_TOKEN=<paste-production-serviceaccount-token>

DR_SERVER=https://api.dr-cluster.example.com:6443
DR_TOKEN=<paste-dr-serviceaccount-token>


# ─── 5. BUILD CONTROL ────────────────────────────────────────────────────────
# Set to "1" on a manual pipeline run to force-rebuild + force-deploy every
# app from a branch (no tag needed). Defaults to "0" in .gitlab-ci.yml.
# Note: this only affects detect / build / plan:staging / deploy:staging —
# plan:production, deploy:production, plan:dr, and deploy:dr only run on a
# real tag push (see WORKFLOW.md §4).

FORCE_BUILD=0


# ─── 6. ARGOCD (PLANNED — NOT USED BY THE CURRENT PIPELINE) ───────────────────
# The argocd/ directory holds AppProject / ApplicationSet / per-env values for
# a future migration from direct Helm to ArgoCD-reconciled GitOps. None of the
# variables below are read by today's pipeline. Fill them in only when you
# switch the deploy jobs over to `argocd app set` / `argocd app sync`.
#
# ARGOCD_NAMESPACE=argocd
# ARGOCD_APP_STAGING=zabbix-portal-staging
# ARGOCD_APP_PRODUCTION=zabbix-portal-production
# ARGOCD_SERVER=argocd.example.com
# ARGOCD_AUTH_TOKEN=<paste-argocd-service-account-token>
# ARGOCD_CLI_VERSION=v2.14.0
# REPO_URL=https://gitlab.example.com/your-org/zabbix-portal.git   # used by argocd manifests
# PROD_TARGET_REVISION=HEAD                                        # used by argocd/application.yaml


# ─── 7. APP RUNTIME SECRETS ───────────────────────────────────────────────────
# These are NOT consumed by CI — they live in a Kubernetes Secret + ConfigMap
# (names set via `existingSecret` / `existingConfigMap` in the umbrella
# values.yaml; defaults: backend-secret / overwatch-config-map). Create them
# in each cluster before deploying. PostgreSQL is shared/external —
# DATABASE_URL points the backend at it.
#
# kubectl -n $K8S_NAMESPACE create secret generic backend-secret \
#   --from-literal=ZABBIX_URL=https://your-zabbix-server \
#   --from-literal=ZABBIX_USER=Admin \
#   --from-literal=ZABBIX_PASS=<password> \
#   --from-literal=SECRET_KEY=<long-random-string> \
#   --from-literal=DATABASE_URL=postgresql://user:password@host:5432/zabbix_portal
#
# kubectl -n $K8S_NAMESPACE create configmap overwatch-config-map \
#   --from-literal=ALLOWED_ORIGINS=https://your-frontend-route.apps.cluster.example.com \
#   --from-literal=BACKEND_URL=http://<release-name>-backend:6769


# ─── 8. INFORMATIONAL ONLY (not read by any CI job) ──────────────────────────
# Documentation hints for humans — no script in .gitlab/ci/ reads these.

BACKEND_PATH=apps/backend
FRONTEND_PATH=apps/frontend
HELM_CHART_PATH=helm/charts/zabbix-portal
NODE_VERSION=22
PYTHON_VERSION=3.12
HELM_VERSION=3.17.0
