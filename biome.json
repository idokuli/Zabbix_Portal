{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "ignore": [
      "**/dist/**",
      "**/node_modules/**",
      "**/.next/**",
      "**/build/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "complexity": {
        "all": true,
        "noVoid": "off"
      },
      "suspicious": {
        "all": true,
        "noReactSpecificProps": "off",
        "noEmptyBlockStatements": "off",
        "noConsole": { "level": "warn", "options": { "allow": ["error", "warn"] } }
      },
      "style": {
        "all": true,
        "useNamingConvention": "off",
        "noImplicitBoolean": "off",
        "noDefaultExport": "off",
        "useFilenamingConvention": "off"
      },
      "performance": {
        "all": true,
        "noBarrelFile": "off"
      },
      "security": { "all": true },
      "a11y": { "all": true }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  }
}
